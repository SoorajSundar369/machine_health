# Virtual environment
.venv/
venv/
ENV/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter cache
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS files
.DS_Store
Thumbs.db

